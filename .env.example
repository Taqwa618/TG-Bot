# ============================================================
#  Шаблон настроек бота обратной связи.
#  1) Скопируйте этот файл и переименуйте копию в ".env"
#  2) Заполните значения ниже
# ============================================================

# Токен бота — получите у @BotFather командой /newbot
BOT_TOKEN=вставьте_сюда_токен_бота

# ID администраторов через запятую.
# Свой ID можно узнать у @userinfobot или отправив боту команду /id
ADMIN_IDS=123456789

# Минимальная пауза между обращениями одного пользователя, секунд (антифлуд)
FLOOD_LIMIT_SECONDS=10

# Необязательно: путь к файлу базы SQLite (по умолчанию feedback.db)
# DB_PATH=feedback.db
